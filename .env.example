# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
# NOTE: backend/db.py uses backend/data/vitals.db directly; no DATABASE_URL override exists.

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
# Internal builds only. Public builds must leave this unset/false to hide training UI/routes.
VITE_ENABLE_TRAINING=false

# Discord Configuration (backend-only; never expose a webhook URL to the browser)
# Get webhook URL: Discord Server → Settings → Webhooks → Create Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token

# Telegram Configuration (backend/bot only; never commit real tokens)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Bot (for commands like !hello, !testalert, !status)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# MQTT Configuration (optional)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=vitals
# MQTT_TLS=true enables TLS; set MQTT_USERNAME/MQTT_PASSWORD for broker auth.

# ML Model Configuration
MODEL_PATH=ml/models/lstm_baseline.pt
PHYSIONET_DATA_PATH=C:\Users\<username>\Downloads\physionet-data

# Training API: when set, POST /training/start requires X-Training-Token.
# Leave unset for open local dev. Obscurity only — use firewall/VPN for real protection.
# TRAINING_API_TOKEN=
# Internal frontend training UI: VITE_ENABLE_TRAINING=true + VITE_TRAINING_API_TOKEN=<same token>

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=true
RELOAD=true
