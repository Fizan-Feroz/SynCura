Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# VSCode
.vscode/
*.code-workspace

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
*.egg-info/
